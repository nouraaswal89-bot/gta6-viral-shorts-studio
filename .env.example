# ==============================================================================
# GTA6 Viral Shorts Studio - Environment Variables
# ==============================================================================

# Required for AI Creative Director (Multimodal clip selection, hooks, meme cues)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model override (default uses gemini-4-hydrogen; legacy gemini-2.5-* are deprecated)
GEMINI_MODEL=gemini-4-hydrogen

# Optional: Pixabay API key for automatic copyright-free BGM discovery
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Faster-Whisper configuration (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Live stream rolling buffer duration in seconds (for active YouTube livestreams)
LIVE_BUFFER_SECONDS=180

# Server & Rendering Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
ENABLE_REMOTION_RENDER=true
RENDER_CONCURRENCY=2
